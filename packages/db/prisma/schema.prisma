// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  plan          UserPlan @default(FREE)
  planExpiresAt DateTime?

  pullRequests        PullRequest[]
  commits             Commit[]
  generatedContent    GeneratedContent[]
  mediaAttachments    MediaAttachment[]
  sessions            Session[]
  accounts            Account[]
  githubInstallations GitHubInstallation[]
  aiCredentials       UserAiCredential[]
  socialConnections   SocialConnection[]
  socialPublications  SocialPublication[]
  feedback            Feedback[]

}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@unique([providerId, accountId])
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
}

model PullRequest {
  id           String   @id @default(cuid())
  userId       String
  owner        String
  repo         String
  number       Int
  title        String
  body         String?
  author       String?
  url          String
  state        String
  headSha      String
  additions    Int
  deletions    Int
  changedFiles Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  generatedContent GeneratedContent[]

  @@index([userId])
  @@index([owner, repo, number])
  @@index([headSha])
  @@index([createdAt])
  @@unique([id, userId])
  @@unique([userId, owner, repo, number, headSha])
}

model Commit {
  id           String   @id @default(cuid())
  userId       String
  owner        String
  repo         String
  sha          String
  shortSha     String
  message      String
  author       String?
  url          String
  additions    Int
  deletions    Int
  changedFiles Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  generatedContent GeneratedContent[]

  @@index([userId])
  @@index([owner, repo, sha])
  @@index([shortSha])
  @@index([createdAt])
  @@unique([id, userId])
  @@unique([userId, owner, repo, sha])
}

model GeneratedContent {
  id               String              @id @default(cuid())
  userId           String
  sourceType       GeneratedSourceType
  pullRequestId    String?
  commitId         String?
  combinedSources  Json?
  contextHash      String?
  xPostLength      XPostLength         @default(STANDARD)
  shortSummary     String
  technicalSummary String
  features         String[]
  techUsed         String[]
  tweet            String
  linkedInPost     String
  redditPost       String
  discordPost      String              @default("")
  portfolioBullet  String
  changelogEntry   String
  beginnerSummary  String
  status           String              @default("ready")
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  pullRequest        PullRequest?      @relation(fields: [pullRequestId, userId], references: [id, userId], onDelete: Cascade)
  commit             Commit?           @relation(fields: [commitId, userId], references: [id, userId], onDelete: Cascade)
  mediaAttachments   MediaAttachment[]
  socialPublications SocialPublication[]

  @@index([userId, createdAt])
  @@index([sourceType])
  @@index([userId, sourceType, contextHash])
  @@index([pullRequestId])
  @@index([commitId])
  @@index([pullRequestId, userId])
  @@index([commitId, userId])
  @@unique([id, userId])
  @@unique([userId, sourceType, contextHash, xPostLength, pullRequestId], map: "GeneratedContent_pr_reuse_key")
  @@unique([userId, sourceType, contextHash, xPostLength, commitId], map: "GeneratedContent_commit_reuse_key")
}

model SocialConnection {
  id                String         @id @default(cuid())
  userId            String
  provider          SocialProvider
  displayName       String
  externalAccountId String
  secretEnc         String
  secretIv          String
  secretTag         String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  publications SocialPublication[]

  @@unique([userId, provider, externalAccountId])
  @@unique([id, userId])
  @@index([userId, updatedAt])
}

model SocialPublication {
  id                 String                  @id @default(cuid())
  userId             String
  connectionId       String?
  generatedContentId String?
  provider           SocialProvider
  status             SocialPublicationStatus @default(PENDING)
  idempotencyKey     String
  externalPostId     String?
  externalPostUrl    String?
  errorMessage       String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection       SocialConnection? @relation(fields: [connectionId, userId], references: [id, userId], onDelete: SetNull)
  generatedContent GeneratedContent? @relation(fields: [generatedContentId, userId], references: [id, userId], onDelete: SetNull)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([connectionId, userId])
  @@index([generatedContentId, userId])
}

model MediaAttachment {
  id                      String            @id @default(cuid())
  userId                  String
  generatedContentId      String?
  generatedContentUserId  String?
  url                     String
  secureUrl               String
  publicId                String
  resourceType            String
  format                  String?
  fileName                String
  mimeType                String
  bytes                   Int
  width                   Int?
  height                  Int?
  duration                Float?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  generatedContent GeneratedContent? @relation(fields: [generatedContentId, generatedContentUserId], references: [id, userId], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([generatedContentId])
  @@index([generatedContentId, generatedContentUserId])
}

model GitHubInstallation {
  id                  String   @id @default(cuid())
  installationId      BigInt   @unique
  accountLogin        String
  accountType         String
  repositorySelection String
  userId              String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositories GitHubInstallationRepository[]

  @@index([userId])
  @@index([accountLogin])
}

model GitHubInstallationRepository {
  id             String @id @default(cuid())
  installationId BigInt
  owner          String
  repo           String
  repoId         BigInt?

  installation GitHubInstallation @relation(fields: [installationId], references: [installationId], onDelete: Cascade)

  @@unique([installationId, owner, repo])
  @@index([owner, repo])
}

model UserAiCredential {
  id        String   @id @default(cuid())
  userId    String
  provider  AiProvider
  apiKeyEnc String
  apiKeyIv  String
  apiKeyTag String
  model     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

model RateLimitBucket {
  key      String   @id
  count    Int
  resetAt  DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  category  String
  message   String
  email     String?
  pagePath  String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([category])
  @@index([userId])
}

enum GeneratedSourceType {
  PULL_REQUEST
  COMMIT
  COMBINED
}

enum XPostLength {
  STANDARD
  PREMIUM
}

enum UserPlan {
  FREE
  PRO
}

enum AiProvider {
  GEMINI
  OPENAI
  ANTHROPIC
  OPENROUTER
}

enum SocialProvider {
  DISCORD
}

enum SocialPublicationStatus {
  PENDING
  PUBLISHED
  FAILED
  UNKNOWN
}
