{
  "name": "@repo/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./github": "./src/github.ts",
    "./changed-file": "./src/changed-file.ts",
    "./pull-request": "./src/pull-request.ts",
    "./pr-cleanup": "./src/pr-cleanup.ts",
    "./generated-content": "./src/generated-content.ts",
    "./generations": "./src/generations.ts",
    "./commit": {
      "types": "./dist/commit.d.ts",
      "default": "./dist/commit.js"
    },
    "./github-app": {
      "types": "./dist/github-app.d.ts",
      "default": "./dist/github-app.js"
    },
    "./ai-credentials": {
      "types": "./dist/ai-credentials.d.ts",
      "default": "./dist/ai-credentials.js"
    },
    "./app-state": "./src/app-state.ts",
    "./electron": "./src/electron.ts"
  },
  "scripts": {
    "build": "tsc && tsc-alias -p tsconfig.json --resolve-full-paths",
    "test": "node --test --import tsx ./test/*.test.ts"
  },
  "dependencies": {
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.6",
    "typescript": "5.9.2"
  }
}
