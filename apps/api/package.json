{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.json src/index.ts",
    "db:generate": "npm --workspace @repo/db run db:generate",
    "build": "npm run db:generate && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths",
    "start": "tsx --tsconfig tsconfig.json src/index.ts",
    "lint": "eslint . --max-warnings 0",
    "check-types": "npm run db:generate && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@clerk/backend": "^3.4.14",
    "@repo/ai": "*",
    "@repo/db": "*",
    "@repo/github": "*",
    "@repo/shared": "*",
    "@hono/node-server": "^1.19.14",
    "hono": "^4.12.15",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/node": "^22.15.3",
    "eslint": "^10.4.1",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.6",
    "typescript": "5.9.2"
  }
}
