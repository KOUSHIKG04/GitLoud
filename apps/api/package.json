{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.json src/index.ts",
    "db:generate": "npm --workspace @repo/db run db:generate",
    "build:packages": "npm --workspace @repo/shared run build && npm --workspace @repo/github run build && npm --workspace @repo/ai run build && npm --workspace @repo/db run build",
    "build": "npm run build:packages && tsc --noEmit -p tsconfig.json && node esbuild.config.mjs",
    "start": "node dist/index.js",
    "lint": "eslint . --max-warnings 0",
    "check-types": "npm run db:generate && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@clerk/backend": "^3.4.14",
    "@hono/node-server": "^1.19.14",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/rest": "^22.0.1",
    "@repo/ai": "*",
    "@repo/db": "*",
    "@repo/github": "*",
    "@repo/shared": "*",
    "hono": "^4.12.15",
    "razorpay": "^2.9.6",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/node": "^22.15.3",
    "esbuild": "^0.27.0",
    "eslint": "^10.4.1",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.6",
    "typescript": "5.9.2"
  }
}
