{
  "name": "gitloud-electron",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently --handle-input --default-input-target 1 \"vite\" \"wait-on http://localhost:5173 && node scripts/dev-electron.cjs\"",
    "dev:debug": "concurrently --handle-input --default-input-target 1 \"vite\" \"wait-on http://localhost:5173 && cross-env ELECTRON_SHOW_DEBUGGER=true node scripts/dev-electron.cjs\"",
    "build": "tsc -b && vite build && electron-builder",
    "preview": "vite preview"
  },
  "build": {
    "icon": "../web/public/app-logo-512.png",
    "win": {
      "icon": "../web/public/app-logo-512.png",
      "signAndEditExecutable": false
    }
  },
  "dependencies": {
    "@repo/ui": "*",
    "@tailwindcss/vite": "^4.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "7zip-bin": "^5.2.0",
    "concurrently": "^10.0.0",
    "cross-env": "^10.1.0",
    "electron": "^31.0.0",
    "electron-builder": "^26.8.1",
    "electronmon": "^2.0.4",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  }
}
